# .env.example -> .env olarak kopyalayin ve degerleri doldurun.
# .env dosyasi git'e commit edilmez.

# --- Django ---
# Uretim icin rastgele uretin:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# Uygulamaya erisilecek alan adlari (virgulle ayrilir)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# HTTPS ile erisilecek adresler (sema dahil, virgulle ayrilir)
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- TLS / reverse proxy ---
# Onunde TLS sonlandiran bir proxy (nginx, Caddy, Traefik...) YOKSA 0 birakin,
# aksi hâlde tarayici sonsuz yonlendirmeye girer.
# Proxy varsa 1 yapin ve proxy'nin X-Forwarded-Proto gonderdiginden emin olun.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
# HSTS'i ancak alan adinin tamami kalici HTTPS oldugunda acin (saniye).
DJANGO_SECURE_HSTS_SECONDS=0

# --- Veritabani (compose'daki postgres servisi) ---
DB_NAME=worker_case_tracker
DB_USER=worker
DB_PASSWORD=change-me-too

# --- Ilk superuser (entrypoint tarafindan olusturulur) ---
# Bos birakilirsa superuser adimi atlanir.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-password
# Her yeniden baslatmada parolayi .env'deki degere gore sifirlamak icin 1 yapin.
DJANGO_SUPERUSER_UPDATE_PASSWORD=0

# --- Host portu ---
WEB_PORT=8000